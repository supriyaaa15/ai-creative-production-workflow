# ─── Local AI Configuration (₹0 / $0 Cost - No API Keys Required) ───────────────
# Uses local Ollama instance with qwen2.5:3b for creative direction, captions, and scoring.
# Start Ollama with: `ollama serve` and `ollama run qwen2.5:3b`
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b


# ─── Server Config ───────────────────────────────────────────────────────────
# Port the API server listens on. Default: 8787
PORT=8787

# The public base URL used to build file URLs in API responses.
PUBLIC_BASE_URL=http://localhost:8787


# ─── Safety & Scale Guards ───────────────────────────────────────────────────
# Max number of source assets per run. Default: 8
MAX_DEMO_ITEMS=8

# Max number of variants per asset. Default: 4
MAX_DEMO_VARIANTS=4

# Number of variants processed in parallel. Default: 3
WORKER_CONCURRENCY=3
